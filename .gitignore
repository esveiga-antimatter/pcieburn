# Run artifacts. Each run directory is tens of MB of traces (a 100 ms NVML
# trace alone is ~20 MB per hour), and the monorepo's pre-commit gate rejects
# files over 500 kB — these should never be committed.
/runs/

# Built binary and objects. pcieburn is compiled on the target node, since the
# machine this is authored on has no CUDA toolchain (see README "Build").
/pcieburn
*.o
